#!/bin/sh
# Bootstrap an isolated runtime, then install or remove KiSesh.

set -u

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime_python="$project_dir/.venv/bin/python"
runtime_cli="$project_dir/.venv/bin/kisesh"

if [ -x "$runtime_cli" ] && "$runtime_python" -c 'import kisesh, tyro' 2>/dev/null; then
    exec "$runtime_python" -m kisesh.installer "$@"
fi

for python in \
    "$HOME/homebrew/bin/python3" \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    "$(command -v python3 2>/dev/null)"
do
    [ -n "$python" ] || continue
    [ -x "$python" ] || continue
    if "$python" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' 2>/dev/null; then
        if [ ! -x "$runtime_python" ]; then
            "$python" -m venv "$project_dir/.venv" || exit 1
        fi
        "$runtime_python" -m pip install --disable-pip-version-check --editable "$project_dir" \
            || exit 1
        exec "$runtime_python" -m kisesh.installer "$@"
    fi
done

printf '%s\n' 'kisesh installer: Python 3.11 or newer was not found' >&2
exit 1
