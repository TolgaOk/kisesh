#!/bin/sh
# Start once and then toggle the same centered Kitty panel. A pre-warmed panel
# starts hidden; normal invocations show it immediately or hide it if visible.

set -u

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
panel_config=${KITTY_WORKBENCH_PANEL_CONFIG:-"$project_dir/integration/quick-access-terminal.conf"}
panel_group=${KITTY_WORKBENCH_PANEL_GROUP:-kitty-workbench}
panel_socket_override=${KITTY_WORKBENCH_PANEL_SOCKET:-}
panel_socket_prefix=/tmp/kitty-workbench-panel
target_socket=${KITTY_WORKBENCH_TARGET_SOCKET:-${KITTY_LISTEN_ON:-}}
prewarm=no

if [ "${1:-}" = "--prewarm" ]; then
    prewarm=yes
    shift
fi
if [ "$#" -eq 0 ]; then
    set -- manager
fi

if [ -z "$target_socket" ]; then
    printf '%s\n' 'kitty-workbench: the main Kitty control socket is unavailable' >&2
    exit 1
fi
case "$target_socket" in
    fd:*)
        printf '%s\n' 'kitty-workbench: the popup needs a persistent unix Kitty socket' >&2
        exit 1
        ;;
esac

kitten_executable=${KITTY_WORKBENCH_KITTEN:-}
if [ -z "$kitten_executable" ]; then
    for candidate in \
        /Applications/kitty.app/Contents/MacOS/kitten \
        "$(command -v kitten 2>/dev/null)"
    do
        [ -n "$candidate" ] || continue
        [ -x "$candidate" ] || continue
        kitten_executable=$candidate
        break
    done
fi
if [ -z "$kitten_executable" ]; then
    printf '%s\n' 'kitty-workbench: kitten was not found' >&2
    exit 1
fi

if [ "$prewarm" = yes ]; then
    "$kitten_executable" quick-access-terminal \
        --instance-group="$panel_group" \
        --config="$panel_config" \
        --override=start_as_hidden=yes \
        /usr/bin/env \
        KITTY_WORKBENCH_CALLER=panel \
        KITTY_WORKBENCH_PANEL_CONFIG="$panel_config" \
        KITTY_WORKBENCH_PANEL_GROUP="$panel_group" \
        KITTY_WORKBENCH_PANEL_SOCKET="${panel_socket_override:-unix:$panel_socket_prefix}" \
        KITTY_WORKBENCH_TARGET_SOCKET="$target_socket" \
        "$project_dir/bin/kitty-workbench" "$@"
else
    "$kitten_executable" quick-access-terminal \
        --instance-group="$panel_group" \
        --config="$panel_config" \
        --override=start_as_hidden=no \
        /usr/bin/env \
        KITTY_WORKBENCH_CALLER=panel \
        KITTY_WORKBENCH_PANEL_CONFIG="$panel_config" \
        KITTY_WORKBENCH_PANEL_GROUP="$panel_group" \
        KITTY_WORKBENCH_PANEL_SOCKET="${panel_socket_override:-unix:$panel_socket_prefix}" \
        KITTY_WORKBENCH_TARGET_SOCKET="$target_socket" \
        "$project_dir/bin/kitty-workbench" "$@"
fi
status=$?
if [ "$status" -ne 0 ]; then
    exit "$status"
fi

# Wake the resident TUI after either edge of a toggle. Ctrl-g has no user
# action; it only asks panel mode to refresh its view and repaint once.
panel_socket=$panel_socket_override
if [ -z "$panel_socket" ]; then
    for candidate in "$panel_socket_prefix" "$panel_socket_prefix"-*
    do
        [ -S "$candidate" ] || continue
        panel_socket="unix:$candidate"
    done
fi
[ -n "$panel_socket" ] || exit 0
"$kitten_executable" @ \
    --to "$panel_socket" \
    send-key \
    --match 'env:KITTY_WORKBENCH_CALLER=panel' \
    ctrl+g >/dev/null 2>&1 || :
